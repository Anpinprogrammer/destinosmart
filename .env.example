# Cliente Supabase — valores públicos; nunca incluir service_role aquí.
# VITE_SUPABASE_ANON_KEY debe ser una publishable key (sb_publishable_...)
# o un JWT anon. Reemplazar los placeholders antes de ejecutar la app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-sb_publishable-or-anon-jwt

# Variables server-side de Supabase Edge Functions (NO configurar en Vercel; solo Supabase Functions):
# SUPABASE_SERVICE_ROLE_KEY=...
# EMAIL_PROVIDER_API_KEY=...
# APP_PUBLIC_URL=https://your-app.example.com
# EMAIL_PROVIDER=mock
# VERIFY_EMAIL_RATE_LIMIT=  # valor pendiente Q-10; no es una decisión
# VERIFY_EMAIL_RATE_WINDOW_SECONDS=300  # ejemplo
